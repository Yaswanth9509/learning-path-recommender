# Copy to .env and set ONE of the providers below.
#
# The application runs fully without any of them — a deterministic rule engine
# handles goal understanding and Q&A. A provider makes the assistant's replies
# genuinely conversational.
#
# Providers are auto-detected in this priority order:
#   anthropic -> gemini -> groq -> openrouter -> ollama
# Set LLM_PROVIDER to pin one explicitly.

# --- Google Gemini — best free option (free tier, no credit card) ----------
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- Groq — free tier, very fast open models -------------------------------
# Get a key at https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter — many models, some tagged :free ---------------------------
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Ollama — fully local, no key, no network, no cost ---------------------
# Install from https://ollama.com then: ollama pull llama3.1
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- Anthropic Claude — paid credits, highest quality ----------------------
# Get a key at https://platform.claude.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# --- Overrides -------------------------------------------------------------
# LLM_PROVIDER=gemini      # pin a provider instead of auto-detecting
# DISABLE_LLM=1            # force the rule engine, ignoring every key
# LEARNING_DB_PATH=backend/learning.db

# --- Serving it to anyone but yourself -------------------------------------
# Everything below defaults to the local-demo setting, so a local run needs
# none of it. Set them before putting the app on a network.
#
# Require a shared secret on every /api route except /api/health. Callers send
# it as `X-API-Key: <key>` or `Authorization: Bearer <key>`.
# API_KEY=
#
# Per-caller request budgets. /api/chat is separate and much tighter because it
# is the route that can spend provider tokens and create learner records.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_PER_MINUTE=240
# RATE_LIMIT_CHAT_PER_MINUTE=20
#
# Comma-separated browser origins allowed to call the API. Default is "*",
# which is right for a local demo and wrong for anything else.
# ALLOWED_ORIGINS=https://learning.example.com
#
# Read the caller's IP from X-Forwarded-For. Set this only when a reverse proxy
# you control sets that header — otherwise callers can forge it and dodge the
# rate limit.
# TRUST_PROXY_HEADER=0
